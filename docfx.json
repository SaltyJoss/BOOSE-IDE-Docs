{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "metadata": [
    {
      "src": [
        {
          "src": "C:\\Users\\Joss\\source\\repos\\ase-boose-assignment-SaltyJoss\\BOOSECoreApp\\bin\\Release\\net8.0-windows",
          "files": [
            "**/*.dll"
          ]
        }
      ],
      "dest": "api"
    },
    {
        "src": [
            {
                "src": "C:\\Users\\Joss\\source\\repos\\ase-boose-assignment-SaltyJoss\\BOOSETests\\bin\\Release\\net8.0-windows",
                "files": [
                    "**/*.dll"
                ]
            }
        ],
        "dest": "api-tests"
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "**/*.{md,yml}"
        ],
        "exclude": [
          "_site/**"
        ]
      }
    ],
    "resource": [
      {
        "files": [
          "images/**"
        ]
      }
    ],
    "output": "docs",
    "template": [
      "default",
      "modern"
    ],
    "globalMetadata": {
      "_appName": "BOOSE IDE Documentation",
      "_appTitle": "BOOSE IDE Documentation",
      "_enableSearch": true,
      "pdf": false
    }
  }
}